# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in the actual values
# NEVER commit the .env file to git - it contains secrets!

# Environment: development, staging, production
ENVIRONMENT=development

# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# Allowed hosts (comma-separated for production)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For Vercel Postgres, use the connection string from Vercel dashboard
DB_NAME=medtag
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# CORS settings - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# URLs for frontend redirects
REACTAPP_RESET_URL=http://localhost:3000/reset-password/
LOGIN_URI=http://localhost:3000/login

PUBLIC_BASE_URL=http://localhost:8000

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# ============================================================================
# AWS S3 CONFIGURATION (For media file storage)
# ============================================================================
USE_S3=True
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=eu-north-1

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# JazzCash/EasyPaisa Configuration
JAZZCASH_TEST_MODE=True
JAZZCASH_MERCHANT_ID=your-merchant-id
JAZZCASH_MERCHANT_PASSWORD=your-merchant-password
JAZZCASH_INTEGRITY_SALT=your-integrity-salt
JAZZCASH_PAY_SIGNING_SALT=your-pay-signing-salt
JAZZCASH_USD_TO_PKR_RATE=278.00
JAZZCASH_RESULT_FRONTEND_URL=http://localhost:3000/payment-result

# Wallet/Payment Sandbox Mode
WALLET_PAYMENT_SANDBOX=True
WALLET_SANDBOX_OTP=4242

# ============================================================================
# AI/ML SERVICES
# ============================================================================
GEMINI_API_KEY=your-gemini-api-key

# ============================================================================
# PAYMENT URLS
# ============================================================================
JAZZCASH_SANDBOX_PAYMENT_POST_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
JAZZCASH_PRODUCTION_PAYMENT_POST_URL=https://payments.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
JAZZCASH_PAY_LINK_MAX_AGE_SECONDS=3600
