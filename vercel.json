{
  "buildCommand": "python manage.py collectstatic --noinput",
  "devCommand": "python manage.py runserver",
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "builds": [
    {
      "src": "med_backend/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "med_backend/wsgi.py"
    }
  ]
}